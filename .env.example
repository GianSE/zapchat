# Copie este arquivo para ".env" e ajuste os valores conforme o seu ambiente.

# String de conexao do MongoDB
MONGODB_URI=mongodb://localhost:27017

# Nome do banco de dados utilizado pela aplicacao
MONGODB_DB=zapchat

# Tempo maximo (ms) de espera para selecionar o servidor do MongoDB
MONGODB_TIMEOUT=5000

# Nivel minimo registrado no arquivo de log: DEBUG | INFO | AVISO | ERRO
LOG_NIVEL=INFO
